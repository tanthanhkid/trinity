# =============================================================================
# Trinity — environment configuration
#
#   cp .env.example .env
#
# Every variable read by the code is listed here, grouped by area. Values are
# PLACEHOLDERS: replace every `change-me-*` value before exposing the app to a
# network. Generate random secrets with:   openssl rand -hex 32
# Variables with a default in the code are commented out (uncomment to override).
# Docker users: docker-compose.yml reads this same file.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core
# -----------------------------------------------------------------------------
NODE_ENV=production

# Monolith (NestJS API: auth, crm, payroll, notification) listens here.
PORT=4000

# PostgreSQL. docker-compose builds DATABASE_URL from the POSTGRES_* values below;
# set DATABASE_URL yourself only when running without Docker.
POSTGRES_USER=trinity
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=trinity
DATABASE_URL=postgresql://trinity:change-me-db-password@localhost:5432/trinity
# Prisma connection pool size (default 10). Lower it on small databases / PgBouncer.
# PRISMA_CONNECTION_LIMIT=10

# Redis (rate limits, RBAC cache, realtime, queues). Database 0 is used by the monolith.
REDIS_URL=redis://localhost:6379/0

# Signs login tokens. REQUIRED, no fallback — services refuse to start without it.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Shared secret for service-to-service calls (header `x-service-secret`).
# INTERNAL_SERVICE_SECRET wins; SERVICE_SECRET is the fallback.
INTERNAL_SERVICE_SECRET=change-me-generate-with-openssl-rand-hex-32
SERVICE_SECRET=change-me-generate-with-openssl-rand-hex-32

# Browser origins allowed by CORS (comma separated; `*.example.com` allows every
# subdomain). localhost on any port is allowed only when NODE_ENV is not production.
# Default: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. First-run seed (packages/prisma/prisma/seed.ts)
# -----------------------------------------------------------------------------
# Admin account created on first run. If SEED_ADMIN_PASSWORD is empty, a random
# password is generated and printed ONCE in the seed log (docker compose logs migrate).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# true = also create a few demo teams/contacts with obviously fake data. Default false:
# if you want demo data, set SEED_DEMO_DATA=true.
SEED_DEMO_DATA=false

# -----------------------------------------------------------------------------
# 3. Web app (Next.js, port 3000)
# -----------------------------------------------------------------------------
# Public base URL of the API as seen by the BROWSER (inlined at build time).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Where the Next.js server proxies /api/v1/* to (server-side only).
BACKEND_URL=http://localhost:4000
# Used for /.well-known/oauth-* rewrites and uploads proxy (default http://127.0.0.1:4000 / http://localhost:4000).
MONOLITH_INTERNAL_URL=http://localhost:4000
AUTH_SERVICE_URL=http://localhost:4000
# Realtime transport for notifications: unset = Socket.IO, `poll` = HTTP polling.
# NEXT_PUBLIC_REALTIME_MODE=poll
# Optional Elasticsearch endpoint for browser error logs (default http://localhost:9200).
# ELASTICSEARCH_URL=http://localhost:9200

# -----------------------------------------------------------------------------
# 4. File storage
# -----------------------------------------------------------------------------
# local (default) = files on disk, s3 = S3/MinIO compatible, vercel-blob = Vercel Blob.
STORAGE_DRIVER=local
# Root folder for STORAGE_DRIVER=local. Must exist and be writable by the service user.
STORAGE_LOCAL_ROOT=/var/lib/trinity/storage
# Folder served at /uploads (avatars, product images). Default: <cwd>/uploads
# UPLOADS_LOCAL_ROOT=
# Employee avatar folder (default derived from the uploads root).
# EMPLOYEE_AVATAR_DIR=

# --- S3 / MinIO (only when STORAGE_DRIVER=s3) ---
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=change-me-access-key
# MINIO_SECRET_KEY=change-me-secret-key
# MINIO_BUCKET=trinity-documents
# MINIO_REGION=us-east-1

# --- Vercel Blob (only when STORAGE_DRIVER=vercel-blob) ---
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=public            # public | private — must match the Blob store type

# -----------------------------------------------------------------------------
# 5. AI connections, webhooks, public integrations (all OFF by default)
# -----------------------------------------------------------------------------
# Trinity never calls an AI vendor with its own key. AI assistants (ChatGPT, Claude,
# any MCP client) connect to Trinity's MCP server; enable it below.
INTEGRATIONS_WEBHOOKS_ENABLED=false
INTEGRATIONS_MCP_ENABLED=false
# Public base URL of this installation (https, no trailing slash). REQUIRED to enable
# MCP/OAuth: it is the OAuth issuer and is NEVER derived from the Host header.
# The only fallback: on Vercel (VERCEL=1) the platform's own production hostname
# (VERCEL_PROJECT_PRODUCTION_URL) is used. Everywhere else, set it explicitly.
INTEGRATIONS_PUBLIC_BASE_URL=
# 32 random bytes, base64 — encrypts webhook secrets and OAuth tokens (AES-256-GCM).
# Required when webhooks, Google or AI/MCP connections are enabled.   Generate: openssl rand -base64 32
INTEGRATIONS_SECRET_KEY=
# Optional: only accept MCP clients from these origins / CIMD client hosts (comma separated).
# INTEGRATIONS_MCP_ALLOWED_ORIGINS=
# INTEGRATIONS_OAUTH_CIMD_ALLOWED_HOSTS=
# DEV/TEST ONLY: allow webhooks to private addresses (ignored in production).
# INTEGRATIONS_ALLOW_PRIVATE_TARGETS=false
# Bearer token that protects GET /api/v1/internal/cron/tick (serverless cron). Unset = endpoint returns 503.
# CRON_SECRET=
# Token for the plan-admin endpoint (usage/plan limits). Unset = disabled.
# TRINITY_PLAN_ADMIN_TOKEN=

# --- Google (Sheets sync) ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://crm.example.com/api/v1/google/oauth/callback
# Public web URL used to build redirect URIs when INTEGRATIONS_PUBLIC_BASE_URL is unset.
# WEB_BASE_URL=

# --- Facebook Page inbox ---
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# Optional: forward webhook events for Pages not connected to THIS install to another Trinity install that uses the same Meta app
# (one callback URL per app). Body and signature are forwarded unchanged.
# FACEBOOK_WEBHOOK_FORWARD_URL=https://other-install.example.com/api/v1/facebook/webhook
# FACEBOOK_GRAPH_VERSION=v25.0

# --- Social posting (Facebook Page, YouTube, TikTok) ---
# Facebook Page reuses FACEBOOK_APP_ID/FACEBOOK_APP_SECRET above; also register the redirect
#   https://crm.example.com/api/v1/social/oauth/callback/facebook in the Meta app.
# YouTube: Google Cloud OAuth client (Web application) with YouTube Data API v3 enabled; redirect
#   https://crm.example.com/api/v1/social/oauth/callback/youtube
# GOOGLE_SOCIAL_CLIENT_ID=
# GOOGLE_SOCIAL_CLIENT_SECRET=
# TikTok: developer app with Login Kit + Content Posting API (Direct Post), scopes user.info.basic + video.publish; redirect
#   https://crm.example.com/api/v1/social/oauth/callback/tiktok
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Google Business Profile (business updates + Google reviews in the inbox): same Google OAuth client as YouTube, plus the
#   Business Profile APIs enabled and approved by Google (quota is 0 until the "Basic API Access" form is approved); redirect
#   https://crm.example.com/api/v1/social/oauth/callback/google_business
# GOOGLE_BUSINESS_ENABLED=true
# See docs/integrations/social.md.
# Contact email shown on the public /privacy and /terms pages (Meta/TikTok app review asks for them).
# LEGAL_CONTACT_EMAIL=
# Operator shown at the bottom of /privacy and /terms (Meta App Review matches it against the business verification documents).
# LEGAL_COMPANY_NAME=
# LEGAL_COMPANY_NAME_EN=
# LEGAL_COMPANY_TAX_ID=
# LEGAL_COMPANY_ADDRESS=
# LEGAL_COMPANY_PHONE=

# --- Zalo Official Account (OA) + ZNS ---
# ZALO_OA_APP_ID=
# ZALO_OA_APP_SECRET=
# OA secret key used to verify webhook signatures (X-ZEvent-Signature).
# ZALO_WEBHOOK_SECRET=
# ZALO_OA_REDIRECT_URI=https://crm.example.com/api/v1/zalo-oa/oauth/callback
# ZALO_OA_POST_CONNECT_URL=/settings
# development = ZNS test mode (no quota used)
# ZALO_ZNS_MODE=development

# --- Online store (feature "online_store", off by default) ---
# Optional subdomain for storefronts: <name>.<STORE_DOMAIN> shows /s/<name>. Needs a wildcard DNS record pointing at the web app.
# STORE_DOMAIN=shop.example.com

# --- Connectors that need Trinity's partner app (empty = row shows "server not configured") ---
# MISA AMIS Kế toán: partner app_id issued by MISA (developer.misa.vn / MISA sales).
# MISA_APP_ID=
# Shopee Open Platform partner app (SHOPEE_SANDBOX=1 = partner.test-stable host).
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_SANDBOX=
# Lazada Open Platform app.
# LAZADA_APP_KEY=
# LAZADA_APP_SECRET=

# -----------------------------------------------------------------------------
# 6. Add-ons ("chương trình con") — sandboxed Deno programs, OFF by default
# -----------------------------------------------------------------------------
# Needs Deno >= 2 on the server (the Docker image installs it). The runner is a
# child process of the monolith, not a separate container.
EXTENSIONS_ENABLED=false
# Path to the deno binary or a wrapper script (default: `deno` from PATH).
# EXTENSIONS_DENO_BIN=deno
# Consecutive failures before an add-on is switched off (default 3).
# EXTENSIONS_MAX_FAILURES=3
# Deno cache dir.
# EXT_DENO_DIR=
# DENO_DIR=

# -----------------------------------------------------------------------------
# 7. Payroll
# -----------------------------------------------------------------------------
# Payroll slips: company name printed on payslips.
# PAYROLL_COMPANY_NAME=

# -----------------------------------------------------------------------------
# 8. Login / attendance hardening (optional)
# -----------------------------------------------------------------------------
# Restrict login to office IPs for selected users (configured in Settings). Default off.
# LOGIN_WIFI_CHECK_ENABLED=false
# LOGIN_WIFI_CHECK_BYPASS_EMAILS=
# Trust the Cloudflare `cf-connecting-ip` header (only behind Cloudflare).
# LOGIN_WIFI_TRUST_CF_IP=false
# ATTENDANCE_TRUST_CF_IP=false
# x-real-ip / x-forwarded-for are trusted only when the connection comes from an internal proxy (loopback/private network). Set true if your proxy
# (e.g. a PaaS) connects from a public address:
# ATTENDANCE_TRUST_PROXY_HEADERS=false
# LOGIN_WIFI_TRUST_PROXY_HEADERS=false
# One active session per user.
# SINGLE_SESSION_ENABLED=false

# -----------------------------------------------------------------------------
# 9. Background jobs (all OFF unless noted)
# -----------------------------------------------------------------------------
# LEAD_SCORING_ENABLED=false
# STALE_REMINDERS_ENABLED=false
# BRIEFING_CRON_ENABLED=false

# -----------------------------------------------------------------------------
# 10. Serverless / Vercel (advanced, optional)
# -----------------------------------------------------------------------------
# TRINITY_RUNTIME=serverless
# TRINITY_MONOLITH_ENTRY=
# TRINITY_TRACE_HOST_ENGINE=

# -----------------------------------------------------------------------------
# 11. End-to-end tests (Playwright) — only needed to run `pnpm --filter web e2e`
# -----------------------------------------------------------------------------
# E2E_BASE_URL=http://localhost:3000
# E2E_ALLOW_WRITE=
# E2E_PHASE=
# E2E_WORKERS=
# E2E_BROWSER_CHANNEL=

# -----------------------------------------------------------------------------
# 12. Monitoring (optional) — everything below is OFF until you set a value.
#     Error reporting (Sentry) and product metrics (PostHog). No network calls and no SDK is
#     loaded while these are empty. See docs/deployment.md ("Monitoring (optional)").
# -----------------------------------------------------------------------------
# DSN used by the API process (server errors, 5xx only).
# SENTRY_DSN=
# DSN used by the browser. Served to the web app through GET /api/v1/telemetry/config.
# SENTRY_DSN_WEB=
# Defaults to NODE_ENV.
# SENTRY_ENVIRONMENT=
# Fraction of requests traced, 0..1.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Release id. Falls back to VERCEL_GIT_COMMIT_SHA (7 chars), then to a `.release` file in APP_ROOT (or the working directory).
# TRINITY_RELEASE=
# PostHog project key (starts with phc_). Enables product events from the API and the browser.
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Session replay, off unless exactly "true". Replay masks all text and inputs.
# POSTHOG_REPLAY=false
# Secret for hashing user ids before they leave your server. Falls back to JWT_SECRET.
# MONITORING_HASH_SECRET=

# API docs (Swagger) at /docs on the API server (port 4000): on by default outside production; set true to enable in production.
# SWAGGER_ENABLED=false
