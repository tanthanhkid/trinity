{
  "name": "@trinity/monolith",
  "version": "0.1.0",
  "private": true,
  "main": "dist/serverless.js",
  "exports": {
    "./serverless": "./dist/serverless.js"
  },
  "description": "Gộp các service NestJS (auth/crm/payroll/notification) vào 1 process",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-serverless-shim.cjs",
    "start": "node dist/apps/monolith/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:rbac": "jest --config test/rbac/jest-e2e.json --runInBand --forceExit",
    "test": "jest --passWithNoTests && tsx --test 'src/__tests__/*.test.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1025.0",
    "@aws-sdk/s3-request-presigner": "^3.1025.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@nestjs/axios": "^3",
    "@nestjs/common": "^10",
    "@nestjs/config": "^3",
    "@nestjs/core": "^10",
    "@nestjs/jwt": "^10",
    "@nestjs/platform-express": "^10",
    "@nestjs/platform-socket.io": "^10",
    "@nestjs/schedule": "^4",
    "@nestjs/swagger": "^7",
    "@nestjs/websockets": "^10",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.76.2",
    "@trinity/logger": "workspace:*",
    "@trinity/prisma": "workspace:*",
    "@trinity/rbac": "workspace:*",
    "@trinity/rbac-nest": "workspace:*",
    "@trinity/storage": "workspace:*",
    "@trinity/utils": "workspace:*",
    "axios": "^1",
    "bcryptjs": "^2",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.10",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9",
    "multer": "2.4.0",
    "node-cron": "^3",
    "pdfkit": "^0.15",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "sharp": "0.35.5",
    "socket.io": "^4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^10",
    "@nestjs/testing": "^10",
    "@types/bcryptjs": "^2",
    "@types/express": "^4",
    "@types/jest": "^29",
    "@types/jsonwebtoken": "^9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22",
    "@types/node-cron": "^3",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6",
    "jest": "^29",
    "supertest": "^7",
    "ts-jest": "^29",
    "tsx": "^4.22.3",
    "typescript": "^5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../test/rbac"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@trinity/prisma$": "<rootDir>/../../../packages/prisma/src"
    },
    "setupFiles": [
      "<rootDir>/internal-ports/__tests__/jest-env.setup.ts"
    ]
  },
  "files": [
    "dist"
  ]
}
