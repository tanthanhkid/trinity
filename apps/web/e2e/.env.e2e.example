# Mẫu biến môi trường cho bộ e2e. KHÔNG điền mật khẩu thật vào file này.
# Cách dùng: cp e2e/.env.e2e.example e2e/.env.e2e (đã gitignore), điền, rồi
#   set -a; source e2e/.env.e2e; set +a
# hoặc export từng biến trong shell. Role nào thiếu email/mật khẩu sẽ bị skip.

E2E_BASE_URL=http://localhost:3000
# Dùng Google Chrome hệ thống thay cho Chromium bundled (mặc định: chromium)
E2E_BROWSER_CHANNEL=chrome
# 1 = cho chạy luồng GHI dữ liệu (e2e:write). Mặc định tắt.
E2E_ALLOW_WRITE=0

E2E_ADMIN_EMAIL=admin@trinity.local
E2E_ADMIN_PASSWORD=
E2E_SALE_EMAIL=sale@trinity.local
E2E_SALE_PASSWORD=
E2E_LEAD_EMAIL=teamlead@trinity.local
E2E_LEAD_PASSWORD=
E2E_DEPT_HEAD_EMAIL=dept_head@trinity.local
E2E_DEPT_HEAD_PASSWORD=
E2E_HR_EMAIL=hr@trinity.local
E2E_HR_PASSWORD=
