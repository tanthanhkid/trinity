    "e2e:full": "node e2e/run-full.mjs",
    "e2e:seed": "E2E_ALLOW_WRITE=1 E2E_PHASE=read playwright test --project=seed",
    "e2e:cleanup": "E2E_ALLOW_WRITE=1 E2E_PHASE=cleanup playwright test --project=cleanup",
    "e2e:write": "node e2e/run-full.mjs",
    "e2e:report": "playwright show-report playwright-report/read"
  },
