{
  "name": "@trinity/logger",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "winston": "^3.11.0",
    "winston-elasticsearch": "^0.19.0",
    "@nestjs/common": "^10",
    "rxjs": "^7"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^22",
    "@types/jest": "^29",
    "jest": "^29",
    "ts-jest": "^29"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
