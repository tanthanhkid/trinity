{
  "name": "@trinity/rbac-nest",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@trinity/rbac": "workspace:*",
    "@trinity/prisma": "workspace:*",
    "@nestjs/common": "^10",
    "@nestjs/core": "^10",
    "@nestjs/jwt": "^10",
    "ioredis": "^5.10.1",
    "rxjs": "^7"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/jest": "^29",
    "@types/node": "^22",
    "jest": "^29",
    "ts-jest": "^29",
    "@nestjs/testing": "^10",
    "@types/express": "^4",
    "reflect-metadata": "^0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@trinity/rbac$": "<rootDir>/../../rbac/src",
      "^@trinity/prisma$": "<rootDir>/../../prisma/src"
    },
    "testEnvironment": "node"
  },
  "files": [
    "dist"
  ]
}
