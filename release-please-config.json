{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "trinity",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "skip-changelog": true,
      "changelog-sections": [
        { "type": "feat", "section": "Tính năng mới" },
        { "type": "fix", "section": "Sửa lỗi" },
        { "type": "perf", "section": "Hiệu năng" },
        { "type": "refactor", "section": "Tái cấu trúc", "hidden": false },
        { "type": "docs", "section": "Tài liệu", "hidden": true },
        { "type": "test", "section": "Kiểm thử", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "chore", "section": "Khác", "hidden": true }
      ]
    }
  }
}
