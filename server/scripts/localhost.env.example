# Mẫu biến môi trường chạy localhost. Sao chép thành localhost.env (script tự nạp nếu có) rồi sửa.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trinity
NODE_ENV=development
# Mỗi secret >= 32 ký tự (script tự sinh nếu để trống): openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-doi-ngay-0123456789abcdef
INTERNAL_SERVICE_SECRET=dev-service-secret-0123456789abcdef0123
CORS_ORIGIN=http://localhost:3000
TRINITY_HTTP_PORT=3000
# Tài khoản Quản trị và mật khẩu tài khoản mẫu (Trưởng nhóm, Sale)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
SAMPLE_PASSWORD=Demo@12345
