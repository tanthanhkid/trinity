{
  "name": "@trinity/auth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@trinity/logger": "workspace:*",
    "@trinity/prisma": "workspace:*",
    "@trinity/rbac": "workspace:*",
    "@trinity/rbac-nest": "workspace:*",
    "@trinity/storage": "workspace:*",
    "@nestjs/common": "^10",
    "@nestjs/core": "^10",
    "@nestjs/jwt": "^10",
    "@nestjs/platform-express": "^10",
    "@nestjs/swagger": "^7",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "exceljs": "^4.4.0",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10",
    "@nestjs/testing": "^10",
    "@types/bcryptjs": "^2",
    "@types/express": "^4",
    "@types/jest": "^29",
    "@types/multer": "^2",
    "@types/node": "^22",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6",
    "jest": "^29",
    "supertest": "^7",
    "ts-jest": "^29",
    "typescript": "^5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@trinity/prisma$": "<rootDir>/../../../packages/prisma/src",
      "^@trinity/rbac-nest$": "<rootDir>/../../../packages/rbac-nest/src",
      "^@trinity/rbac$": "<rootDir>/../../../packages/rbac/src"
    },
    "testEnvironment": "node"
  }
}
