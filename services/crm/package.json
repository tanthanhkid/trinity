{
  "name": "@trinity/crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:deno": "deno check --no-lock ext-deno/*.ts",
    "plan:set": "tsx scripts/set-plan.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@trinity/logger": "workspace:*",
    "@trinity/prisma": "workspace:*",
    "@trinity/rbac": "workspace:*",
    "@trinity/rbac-nest": "workspace:*",
    "@trinity/storage": "workspace:*",
    "@trinity/utils": "workspace:*",
    "@nestjs/common": "^10",
    "@nestjs/config": "^3",
    "@nestjs/core": "^10",
    "@nestjs/jwt": "^10",
    "@nestjs/platform-express": "^10",
    "@nestjs/swagger": "^7",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "ioredis": "^5.10.1",
    "multer": "2.4.0",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "sharp": "0.35.5",
    "bcryptjs": "^2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^10",
    "@nestjs/testing": "^10",
    "@types/bcryptjs": "^2",
    "@types/express": "^4",
    "@types/jest": "^29",
    "@types/multer": "^2.1.0",
    "@types/node": "^22",
    "jest": "^29",
    "ts-jest": "^29",
    "tsx": "^4.22.3",
    "typescript": "^5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@trinity/prisma$": "<rootDir>/../../../packages/prisma/src",
      "^@trinity/rbac-nest$": "<rootDir>/../../../packages/rbac-nest/src",
      "^@trinity/rbac$": "<rootDir>/../../../packages/rbac/src"
    }
  }
}
