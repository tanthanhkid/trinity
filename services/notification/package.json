{
  "name": "@trinity/notification",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trinity/logger": "workspace:*",
    "@trinity/prisma": "workspace:*",
    "@trinity/rbac": "workspace:*",
    "@trinity/rbac-nest": "workspace:*",
    "@nestjs/common": "^10",
    "@nestjs/core": "^10",
    "@nestjs/platform-express": "^10",
    "@nestjs/platform-socket.io": "^10",
    "@nestjs/swagger": "^7",
    "@nestjs/websockets": "^10",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "@nestjs/schedule": "^4",
    "handlebars": "^4.7.10",
    "jsonwebtoken": "^9",
    "reflect-metadata": "^0.2",
    "socket.io": "^4",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10",
    "@nestjs/testing": "^10",
    "@types/express": "^4",
    "@types/jest": "^29",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^22",
    "jest": "^29",
    "ts-jest": "^29",
    "typescript": "^5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@trinity/prisma$": "<rootDir>/../../../packages/prisma/src",
      "^@trinity/rbac-nest$": "<rootDir>/../../../packages/rbac-nest/src",
      "^@trinity/rbac$": "<rootDir>/../../../packages/rbac/src"
    },
    "testEnvironment": "node"
  }
}
