# Hồ sơ gốc: mọi tính năng tích hợp bật, nhiều công ty, API điều khiển test bật. Các hồ sơ khác chỉ ghi phần KHÁC.
NODE_ENV=test
TZ=UTC
MULTI_TENANT=true
SIGNUP_ENABLED=true
TRINITY_TEST_HOOKS=1
INTEGRATIONS_WEBHOOKS_ENABLED=true
INTEGRATIONS_MCP_ENABLED=true
# `@BASE@` được bộ chạy thay bằng địa chỉ thật của máy chủ (theo CONTRACT_PORT)
INTEGRATIONS_PUBLIC_BASE_URL=@BASE@
INTEGRATIONS_SECRET_KEY=Y29udHJhY3QtdGVzdC1rZXktMDEyMzQ1Njc4OWFiY2Q=
TRUSTED_PROXY=cidr:127.0.0.1/32;header=x-real-ip
STORAGE_DRIVER=local
# Kênh: ứng dụng giả; địa chỉ gốc Graph/Zalo do bộ chạy trỏ tới máy chủ giả (mock/channels.ts), không đặt ở đây.
FACEBOOK_APP_ID=contract-fb-app
FACEBOOK_APP_SECRET=contract-fb-app-secret-0123456789
FACEBOOK_WEBHOOK_VERIFY_TOKEN=contract-fb-verify
ZALO_OA_APP_ID=contract-zalo-app
ZALO_OA_APP_SECRET=contract-zalo-app-secret-0123456789
ZALO_OA_REDIRECT_URI=http://127.0.0.1:4310/api/v1/zalo-oa/oauth/callback
