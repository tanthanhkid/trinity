# NODE_ENV=production: không có API điều khiển test; ca chỉ seed bằng SQL, không chạy job.
# Phía Rust hồ sơ này chạy trên binary phát hành (không phải bản test-hooks).
NODE_ENV=production
TRINITY_TEST_HOOKS=
INTEGRATIONS_ALLOW_PRIVATE_TARGETS=true
JWT_SECRET=contract-production-jwt-secret-0123456789abcdef
SERVICE_SECRET=contract-production-service-secret-0123456789ab
INTERNAL_SERVICE_SECRET=contract-production-service-secret-0123456789ab
